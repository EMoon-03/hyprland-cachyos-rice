// Generated by matugen from {{image}} - do not edit.
// The source is ~/.config/matugen/templates/fastfetch.jsonc.
// Arcade greeting: the attract row is animated by ~/.local/bin/arcade-fetch, and the
// 1UP number comes from ~/.local/bin/arcade-score.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/arcade-title.txt",
    "position": "top",
    "color": {
      "1": "38;2;{{colors.error.default.red}};{{colors.error.default.green}};{{colors.error.default.blue}}",
      "2": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}",
      "3": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}",
      "4": "38;2;{{colors.tertiary.default.red}};{{colors.tertiary.default.green}};{{colors.tertiary.default.blue}}",
      "5": "38;2;{{colors.tertiary.default.red}};{{colors.tertiary.default.green}};{{colors.tertiary.default.blue}}"
    },
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "display": {
    "separator": "",
    "key": {
      "width": 14,
      "paddingLeft": 8
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#38;2;{{colors.outline.default.red}};{{colors.outline.default.green}};{{colors.outline.default.blue}}}         C A C H Y O S   E D I T I O N"
    },
    "break",
    {
      "type": "custom",
      "format": "                      {#1;38;2;{{colors.error.default.red}};{{colors.error.default.green}};{{colors.error.default.blue}}}1UP"
    },
    {
      "type": "command",
      "key": " ",
      "text": "~/.local/bin/arcade-score",
      "format": "{#1;38;2;{{colors.on_surface.default.red}};{{colors.on_surface.default.green}};{{colors.on_surface.default.blue}}}                    {result}"
    },
    "break",
    {
      "type": "custom",
      "format": "      {#38;2;{{colors.error.default.red}};{{colors.error.default.green}};{{colors.error.default.blue}}} {#38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}} {#38;2;{{colors.secondary.default.red}};{{colors.secondary.default.green}};{{colors.secondary.default.blue}}} {#38;2;{{colors.on_surface.default.red}};{{colors.on_surface.default.green}};{{colors.on_surface.default.blue}}}   {#1;38;2;{{colors.tertiary.default.red}};{{colors.tertiary.default.green}};{{colors.tertiary.default.blue}}}󰮯 {#38;2;{{colors.outline.default.red}};{{colors.outline.default.green}};{{colors.outline.default.blue}}}· {#38;2;{{colors.outline.default.red}};{{colors.outline.default.green}};{{colors.outline.default.blue}}}· {#38;2;{{colors.outline.default.red}};{{colors.outline.default.green}};{{colors.outline.default.blue}}}· {#38;2;{{colors.outline.default.red}};{{colors.outline.default.green}};{{colors.outline.default.blue}}}· {#38;2;{{colors.outline.default.red}};{{colors.outline.default.green}};{{colors.outline.default.blue}}}· {#38;2;{{colors.outline.default.red}};{{colors.outline.default.green}};{{colors.outline.default.blue}}}· {#38;2;{{colors.on_surface.default.red}};{{colors.on_surface.default.green}};{{colors.on_surface.default.blue}}}● {#38;2;{{colors.outline.default.red}};{{colors.outline.default.green}};{{colors.outline.default.blue}}}· {#38;2;{{colors.outline.default.red}};{{colors.outline.default.green}};{{colors.outline.default.blue}}}· {#38;2;{{colors.outline.default.red}};{{colors.outline.default.green}};{{colors.outline.default.blue}}}· {#38;2;{{colors.outline.default.red}};{{colors.outline.default.green}};{{colors.outline.default.blue}}}· {#38;2;{{colors.outline.default.red}};{{colors.outline.default.green}};{{colors.outline.default.blue}}}· {#38;2;{{colors.outline.default.red}};{{colors.outline.default.green}};{{colors.outline.default.blue}}}·"
    },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;{{colors.tertiary.default.red}};{{colors.tertiary.default.green}};{{colors.tertiary.default.blue}}}              ── HALL OF FAME ──"
    },
    "break",
    {
      "type": "custom",
      "format": "        {#38;2;{{colors.outline.default.red}};{{colors.outline.default.green}};{{colors.outline.default.blue}}}RANK  SCORE          NAME"
    },
    {
      "type": "cpu",
      "key": "1ST",
      "format": "{name~12}        CPU",
      "keyColor": "1;38;2;{{colors.error.default.red}};{{colors.error.default.green}};{{colors.error.default.blue}}",
      "outputColor": "38;2;{{colors.error.default.red}};{{colors.error.default.green}};{{colors.error.default.blue}}"
    },
    {
      "type": "gpu",
      "key": "2ND",
      "format": "{name~8}       GPU",
      "keyColor": "1;38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}",
      "outputColor": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}"
    },
    {
      "type": "memory",
      "key": "3RD",
      "format": "{total}      RAM",
      "keyColor": "1;38;2;{{colors.tertiary.default.red}};{{colors.tertiary.default.green}};{{colors.tertiary.default.blue}}",
      "outputColor": "38;2;{{colors.tertiary.default.red}};{{colors.tertiary.default.green}};{{colors.tertiary.default.blue}}"
    },
    {
      "type": "disk",
      "key": "4TH",
      "format": "{size-total}       SSD",
      "keyColor": "1;38;2;{{colors.secondary.default.red}};{{colors.secondary.default.green}};{{colors.secondary.default.blue}}",
      "outputColor": "38;2;{{colors.secondary.default.red}};{{colors.secondary.default.green}};{{colors.secondary.default.blue}}",
      "folders": "/"
    },
    {
      "type": "wm",
      "key": "5TH",
      "format": "{version}         HYPRLAND",
      "keyColor": "1;38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}",
      "outputColor": "38;2;{{colors.primary.default.red}};{{colors.primary.default.green}};{{colors.primary.default.blue}}"
    },
    {
      "type": "kernel",
      "key": "6TH",
      "format": "{release~0,5}          KERNEL",
      "keyColor": "1;38;2;{{colors.tertiary.default.red}};{{colors.tertiary.default.green}};{{colors.tertiary.default.blue}}",
      "outputColor": "38;2;{{colors.tertiary.default.red}};{{colors.tertiary.default.green}};{{colors.tertiary.default.blue}}"
    },
    "break"
  ]
}
