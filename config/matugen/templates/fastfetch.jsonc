// Generated by matugen from {{image}} - do not edit.
// The source is ~/.config/matugen/templates/fastfetch.jsonc.
// Greeting: Uruk. The system as a Servant's status sheet under the name of
// Ur-Nungal (son of Gilgamesh, king of Uruk) in cuneiform: UR DINGIR NUN GAL.
// fish_greeting puts his seal beside it (~/.config/fastfetch/ur-nungal.png,
// kitty only). Fixed gold and lapis colours to go with kitty's dark blue.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // The seal is passed by fish_greeting (kitty only); no ASCII art.
  "logo": { "type": "none" },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;212;175;55", "title": "1;38;2;212;175;55" },
    "key": { "width": 17 }
  },
  "modules": [
    "break",
    { "type": "custom", "format": "{#1;38;2;232;200;90}𒌨 𒀭 𒉣 𒃲 {#0}{#38;2;142;151;171}   Ur-Nungal · King of Uruk" },
    { "type": "custom", "format": "{#38;2;93;102;128}───────────────{#38;2;212;175;55} 𒀭 {#38;2;93;102;128}───────────────" },
    { "type": "title",  "key": "Master",         "format": "{user-name}{#38;2;142;151;171} @ {#0}{host-name}" },
    { "type": "os",     "key": "True Name",      "format": "{pretty-name}" },
    { "type": "wm",     "key": "Class",          "format": "{pretty-name} {version}" },
    { "type": "kernel", "key": "Spirit Origin",  "format": "{release}" },
    { "type": "cpu",    "key": "STR",            "format": "{name}" },
    { "type": "gpu",    "key": "MANA",           "format": "{name}" },
    { "type": "memory", "key": "END",            "format": "{used} / {total}" },
    { "type": "disk",   "key": "AGI",            "folders": "/", "format": "{size-used} / {size-total}" },
    { "type": "uptime", "key": "LUCK",           "format": "{?days}{days}d {?}{hours}h {minutes}m" },
    { "type": "shell",  "key": "Noble Phantasm", "format": "{pretty-name}" }
  ]
}
