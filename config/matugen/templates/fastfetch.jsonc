// Generated by matugen from {{image}} - do not edit.
// The source is ~/.config/matugen/templates/fastfetch.jsonc.
// Greeting: system info with keys numbered in Roman numerals, beside the statue
// picture fish_greeting adds (rice-statue). Fixed gold and marble colours to go
// with kitty's dark blue background.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // The statue picture is passed by fish_greeting (kitty only); no ASCII art.
  "logo": { "type": "none" },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;212;175;55", "title": "1;38;2;212;175;55" },
    "key": { "width": 14 }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name}{#38;2;142;151;171} @ {#1;38;2;212;175;55}{host-name}" },
    { "type": "custom", "format": "{#38;2;93;102;128}────────────────────────────────" },
    { "type": "os",     "key": "I     os",     "format": "{pretty-name}" },
    { "type": "kernel", "key": "II    kernel", "format": "{release}" },
    { "type": "wm",     "key": "III   wm",     "format": "{pretty-name} {version}" },
    { "type": "cpu",    "key": "IV    cpu",    "format": "{name}" },
    { "type": "gpu",    "key": "V     gpu",    "format": "{name}" },
    { "type": "memory", "key": "VI    ram",    "format": "{used} / {total}" },
    { "type": "disk",   "key": "VII   disk",   "folders": "/", "format": "{size-used} / {size-total}" },
    { "type": "uptime", "key": "VIII  up",     "format": "{?days}{days}d {?}{hours}h {minutes}m" },
    { "type": "shell",  "key": "IX    shell",  "format": "{pretty-name}" }
  ]
}
