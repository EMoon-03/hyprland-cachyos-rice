// Generated by matugen from {{image}} - do not edit.
// The source is ~/.config/matugen/templates/fastfetch.jsonc.
// Greeting: 永遠堂 (Eien-dō), the Hall of Eternity. The system as a job ticket
// from the carpentry workshop, under its name board (fish_greeting adds
// ~/.config/fastfetch/eien-do.png, kitty only). 𒂍 𒁕 𒊑 is é da-rí, "house of
// forever". Fixed cedar and paper colours to go with kitty's dark blue.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // The board is passed by fish_greeting (kitty only); no ASCII art.
  "logo": { "type": "none" },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;196;150;104", "title": "38;2;232;224;208", "output": "38;2;232;224;208" },
    "key": { "width": 11 }
  },
  "modules": [
    "break",
    { "type": "custom", "format": "{#1;38;2;232;224;208}永遠堂{#0}{#38;2;142;151;171}  Eien-dō · {#38;2;196;150;104}𒂍 𒁕 𒊑" },
    { "type": "custom", "format": "{#38;2;93;102;128}──────────────────────────────" },
    { "type": "title",  "key": "for",      "format": "{user-name}" },
    { "type": "os",     "key": "received", "format": "{pretty-name}" },
    { "type": "wm",     "key": "frame",    "format": "{pretty-name} {version}" },
    { "type": "cpu",    "key": "grain",    "format": "{name}" },
    { "type": "gpu",    "key": "finish",   "format": "{name}" },
    { "type": "memory", "key": "joinery",  "format": "{used} / {total} · no nails" },
    { "type": "disk",   "key": "stock",    "folders": "/", "format": "{size-used} / {size-total}" },
    { "type": "shell",  "key": "tools",    "format": "{pretty-name}" },
    { "type": "uptime", "key": "open",     "format": "{?days}{days}d {?}{hours}h {minutes}m" },
    { "type": "custom", "key": "ready",    "format": "tomorrow" }
  ]
}
