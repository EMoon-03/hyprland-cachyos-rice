#!/usr/bin/env python3
"""Keeps Thunar the way this rice wants it. Safe to run any time; Hyprland runs
it at every login (conf.d/50-eddie.lua), so a fresh install comes out the same.

  folders     Music and Videos created and registered as your XDG folders
              (apps save there), if they're missing
  sidebar     Downloads, Documents, Pictures, Music, Videos;
              no duplicate home entry; Computer, Desktop and Browse Network
              hidden (anything else you hide with right-click stays hidden)
  thumbnails  for every file, not just local ones
  right-click "Open in Yazi" on folders; "Set as wallpaper" and
              "Set as side-monitor wallpaper" on pictures
"""
import os
import shutil
import subprocess
from urllib.parse import quote

HOME = os.path.normpath(os.path.expanduser("~"))
CONF = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")


def uri(path):
    return "file://" + quote(path)


def xdg(name, fallback):
    """Folder for an XDG name. A folder you don't have comes back as your home,
    often as "$HOME/" with a slash - normpath makes that compare equal to HOME."""
    try:
        p = subprocess.run(["xdg-user-dir", name], capture_output=True, text=True).stdout.strip()
    except OSError:
        p = ""
    return os.path.normpath(p or os.path.join(HOME, fallback))


# ---- Music and Videos folders ------------------------------------------------
# An XDG folder you don't have points at home; give Music and Videos real ones.
if shutil.which("xdg-user-dirs-update"):
    for name, folder in (("MUSIC", "Music"), ("VIDEOS", "Videos")):
        if xdg(name, folder) == HOME:
            path = os.path.join(HOME, folder)
            os.makedirs(path, exist_ok=True)
            subprocess.run(["xdg-user-dirs-update", "--set", name, path], capture_output=True)

# ---- sidebar bookmarks -------------------------------------------------------
bm_file = os.path.join(CONF, "gtk-3.0", "bookmarks")
os.makedirs(os.path.dirname(bm_file), exist_ok=True)
try:
    lines = [l.rstrip("\n") for l in open(bm_file) if l.strip()]
except OSError:
    lines = []
home_uris = {uri(HOME), uri(HOME) + "/"}
kept, seen = [], set()
for line in lines:
    u = line.split(" ", 1)[0]
    if u in home_uris or u in seen:          # home is already in the sidebar; no duplicates
        continue
    seen.add(u)
    kept.append(line)
for name, fallback in [("DOWNLOAD", "Downloads"), ("DOCUMENTS", "Documents"), ("PICTURES", "Pictures"),
                       ("MUSIC", "Music"), ("VIDEOS", "Videos")]:
    p = xdg(name, fallback)
    if p != HOME and os.path.isdir(p) and uri(p) not in seen:
        seen.add(uri(p))
        kept.append(uri(p))
if kept != lines:
    with open(bm_file, "w") as f:
        f.write("\n".join(kept) + "\n")

# ---- Thunar settings (xfconf) ------------------------------------------------
if shutil.which("xfconf-query"):
    def q(*args):
        return subprocess.run(["xfconf-query", "-c", "thunar", *args], capture_output=True, text=True)
    out = q("-p", "/hidden-bookmarks").stdout.splitlines()
    hidden = [l.strip() for l in out if "://" in l]
    for u in ("computer:///", "network:///", uri(xdg("DESKTOP", "Desktop"))):
        if u not in hidden:
            hidden.append(u)
    args = []
    for u in hidden:
        args += ["-t", "string", "-s", u]
    q("-p", "/hidden-bookmarks", "-n", "-a", *args)
    q("-p", "/misc-thumbnail-mode", "-n", "-t", "string", "-s", "THUNAR_THUMBNAIL_MODE_ALWAYS")

# ---- right-click "Open in Yazi" ----------------------------------------------
uca = os.path.join(CONF, "Thunar", "uca.xml")
IMAGES = "*.jpg;*.jpeg;*.png;*.webp;*.JPG;*.JPEG;*.PNG;*.WEBP"
actions = [  # (unique id, icon, name, command, patterns, appears on)
    ("rice-open-in-yazi", "system-file-manager", "Open in Yazi",
     "kitty --class yazi -e yazi %f", "*", "<directories/>"),
    ("rice-set-wallpaper", "preferences-desktop-wallpaper", "Set as wallpaper",
     "~/.local/bin/rice-wallpaper set %f", IMAGES, "<image-files/>"),
    ("rice-set-side-wallpaper", "video-display", "Set as side-monitor wallpaper",
     "~/.local/bin/side-monitor wallpaper %f", IMAGES, "<image-files/>"),
]
try:
    text = open(uca).read()
except OSError:
    text = '<?xml version="1.0" encoding="UTF-8"?>\n<actions>\n</actions>\n'
added = False
for uid, icon, name, cmd, patterns, kind in actions:
    if uid in text or "</actions>" not in text:
        continue
    block = (f"<action>\n\t<icon>{icon}</icon>\n\t<name>{name}</name>\n\t<submenu></submenu>\n"
             f"\t<unique-id>{uid}</unique-id>\n\t<command>{cmd}</command>\n\t<description>{name}</description>\n"
             f"\t<range></range>\n\t<patterns>{patterns}</patterns>\n\t<startup-notify/>\n\t{kind}\n</action>\n")
    text = text.replace("</actions>", block + "</actions>", 1)
    added = True
if added:
    os.makedirs(os.path.dirname(uca), exist_ok=True)
    with open(uca, "w") as f:
        f.write(text)
