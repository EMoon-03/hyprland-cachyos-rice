#!/bin/sh
# Prints the 1UP number on the arcade greeting: your total score. Every terminal
# you open adds the dots Pac-Man eats (see arcade-fetch), so it keeps going up.
d="${XDG_STATE_HOME:-$HOME/.local/state}/arcade"
v=$(cat "$d/score" 2>/dev/null)
case "$v" in ''|*[!0-9]*) v=0 ;; esac
printf '%06d\n' "$v"
